# LOCAL defaults. CLI does NOT load this file automatically.
# Windows PowerShell: $env:RPC_URL = "http://127.0.0.1:8545"
# Windows PowerShell: $env:LAB_CHAIN_ID = "1337"
# Local Geth uses its dev account; PRIVATE_KEY is not needed.
RPC_URL=http://127.0.0.1:8545
LAB_CHAIN_ID=1337

# Optional Sepolia (not required for the local lab):
# RPC_URL=https://YOUR_SEPOLIA_RPC
# LAB_CHAIN_ID=11155111
# PRIVATE_KEY=YOUR_TESTNET_ONLY_PRIVATE_KEY
# Never put real keys in this template or commit a private .env file.
